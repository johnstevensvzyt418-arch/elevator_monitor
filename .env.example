# ============================================================
# Elevator Monitor — 环境变量配置模板
# 复制此文件为 .env 并填写实际值:
#   cp .env.example .env
# ============================================================

# ---- MySQL 数据库 ----
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_PORT=3307

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MQTT Broker (EMQX) ----
MQTT_BROKER_URL=tcp://tcp.sealosbja.site:35205
MQTT_BROKER_PORT=35205
MQTT_CLIENT_ID=elevator-monitor-prod
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- 云平台接入 ----
PLATFORM_WEB_URL=https://aqwtmupbegka.sealosbja.site
PLATFORM_API_BASE=https://bbjxeudameoz.sealosbja.site/api
PLATFORM_WS_URL=wss://bbjxeudameoz.sealosbja.site/ws
PLATFORM_USERNAME=
PLATFORM_PASSWORD=

# ---- 服务端口 ----
BACKEND_PORT=10008
FRONTEND_PORT=8080
AI_SERVICE_PORT=8000

# ---- AI 服务地址 ----
AI_SERVICE_URL=http://ai_service:8000
