# ============================================================
# Elevator Monitor — MQTT 桥接器 Docker 镜像
# ============================================================
FROM python:3.11-alpine

WORKDIR /app

# 安装依赖（paho-mqtt >=2.0 支持 MQTTv5 + CallbackAPIVersion.VERSION2）
RUN pip install --no-cache-dir "paho-mqtt>=2.0"

# 复制桥接脚本
COPY mqtt_bridge.py .

# 启动
ENTRYPOINT ["python", "mqtt_bridge.py"]
